# APP_URL: The URL where this application is hosted.
# Used for CORS, self-referential links, and OAuth callbacks.
APP_URL="http://localhost:5173"

# Optional: set to protect ingest and MCP endpoints. Leave empty for open local dev.
NEXORA_API_KEY=your-secret-api-key-here

# Optional: GitHub personal access token to increase API rate limits (60 → 5000 req/hr).
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your-github-personal-access-token-here
