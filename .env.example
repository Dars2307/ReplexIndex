# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# Public URL of this deployment (CORS for account routes, OAuth redirects).
APP_URL=http://localhost:3000

# Supabase — Replex uses the "replex" schema of a shared project.
# Browser (safe to expose): Project Settings → API Keys → Publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only (secret): Project Settings → API Keys → Secret keys (sb_secret_…).
# SUPABASE_SERVICE_ROLE_KEY (legacy service_role JWT) is still accepted.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# 32 random bytes, base64. Encrypts users' GitHub tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Optional: Gemini API key (Google AI Studio) for AI smart search. Signed-in
# users get 25 AI searches/day. Model defaults to gemini-3.5-flash with
# fallbacks; override with GEMINI_MODEL / GEMINI_FALLBACK_MODELS (comma list).
GEMINI_API_KEY=

# Optional, recommended: GitHub fine-grained token with no permissions. Used for
# signed-out visitors and as a fallback when a user's own token is unavailable.
GITHUB_TOKEN=
